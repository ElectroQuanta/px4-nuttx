include armv7-m/Make.defs

# Required mx8mn files

CHIP_CSRCS  = mx8mn_start.c mx8mn_allocateheap.c mx8mn_iomuxc.c mx8mn_lowputc.c
CHIP_CSRCS += mx8mn_clrpend.c mx8mn_irq.c mx8mn_mpuinit.c mx8mn_ccm.c
CHIP_CSRCS += mx8mn_serial.c mx8mn_clockconfig.c mx8mn_gpio.c

# Configuration-dependent files

ifneq ($(CONFIG_ARCH_IDLE_CUSTOM),y)
CHIP_CSRCS += mx8mn_idle.c
endif

ifneq ($(CONFIG_SCHED_TICKLESS),y)
CHIP_CSRCS += mx8mn_timerisr.c
endif

ifeq ($(CONFIG_I2C),y)
CHIP_CSRCS += mx8mn_i2c.c
endif

ifeq ($(CONFIG_SPI),y)
CHIP_CSRCS += mx8mn_ecspi.c
endif

ifeq ($(CONFIG_MX8MN_RPMSG),y)
CHIP_CSRCS += mx8mn_rptun.c mx8mn_ipc.c mx8mn_rsctable.c
endif
